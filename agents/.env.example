# fee-fi-fo-fum agents. Copy to agents/.env, which git ignores. Real values never go in git.

# Ethereum Sepolia (chain id 11155111). Both public endpoints below answered eth_chainId on 2026-09-26.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_RPC_URL_FALLBACK=https://sepolia.gateway.tenderly.co
# Optional third endpoint, tried after the fallback.
SEPOLIA_RPC_URL_FALLBACK_2=https://1rpc.io/sepolia

# Etherscan verification and links. The operator supplies the key as a 0600 file; set one of these two.
ETHERSCAN_API_KEY=
ETHERSCAN_API_KEY_FILE=

# Each agent's self-custodied Sepolia EOA: a file holding one 0x-prefixed private key, mode 0600,
# outside the repo. agents/scripts/new-wallets creates them; nothing prints or commits them.
FEE_KEY_PATH=~/.handoff/agents/fee/sepolia.key
FI_KEY_PATH=~/.handoff/agents/fi/sepolia.key
FO_KEY_PATH=~/.handoff/agents/fo/sepolia.key
FUM_KEY_PATH=~/.handoff/agents/fum/sepolia.key

# handoff identity. Each agent signs its requests with the sig_privkey in $HANDOFF_HOME/agents/<id>/config.json
# (0600). No bearer key is sent.
HANDOFF_API=https://handoff.lol/api/v1
HANDOFF_HOME=~/.handoff

# Contract addresses are read from contracts/deployments/sepolia.json and are never hard-coded or set here.
# Pre-existing tokens the crew holds: Circle USDC 0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238,
# WETH9 0xfFf9976782d46CC05630D1f6eBAb18b2324d6B14.
DEPLOYMENTS_PATH=../contracts/deployments/sepolia.json

# Local rehearsal: point SEPOLIA_RPC_URL at an anvil fork (anvil --fork-url $SEPOLIA_RPC_URL) to dry-run
# without spending Sepolia ETH.
