# castle service. Real values stay out of git.
PORT=8787
# Primary and fallback Sepolia RPCs (the same names contracts/foundry.toml reads).
SEPOLIA_RPC_URL=
SEPOLIA_RPC_URL_FALLBACK=https://ethereum-sepolia-rpc.publicnode.com
# Addresses, ABIs, crew and display names. Defaults point into this repo; override for a hosted deploy.
CASTLE_DEPLOYMENTS=../contracts/deployments/sepolia.json
CASTLE_ABI_DIR=../contracts/out-abi
CASTLE_MINIAPP_CONFIG=../miniapp/config.json
# Where the castle stream is persisted (events-<vault>.jsonl).
CASTLE_DATA_DIR=./data
# handoff.lol public API, for agent_heartbeat liveness of fee/fi/fo/fum.
HANDOFF_API=https://handoff.lol/api/v1
# Seconds between chain polls.
CASTLE_POLL_SECONDS=4
# The public root of this service, for the gateway URL in the stream's config (https://handoff.lol/t/castle).
CASTLE_PUBLIC_URL=
# fi's Sepolia key (one 0x-prefixed key, mode 0600, outside the repo): signs each harp Quote and each gateway response.
CASTLE_FI_KEY_PATH=
# fo's route endpoint for castle_route (fo answers POST /route on 127.0.0.1:FO_PORT).
FO_URL=http://127.0.0.1:8731
# Harp quotes live CASTLE_QUOTE_TTL_S seconds (at most 300 on-chain); the gateway goes silent when fee's price is
# older than CASTLE_FEE_STALE_S.
CASTLE_QUOTE_TTL_S=30
CASTLE_FEE_STALE_S=60
# SSE responses close after this many ms so a buffering tunnel relays them (0 keeps them open).
CASTLE_SSE_WINDOW_MS=0
