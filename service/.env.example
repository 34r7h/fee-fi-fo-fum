# castle service. Real values stay out of git.
PORT=8787
# Primary and fallback Sepolia RPCs (the same names contracts/foundry.toml reads).
SEPOLIA_RPC_URL=
SEPOLIA_RPC_URL_FALLBACK=https://ethereum-sepolia-rpc.publicnode.com
# Addresses, ABIs and shift table. Defaults point into this repo; override for a hosted deploy.
CASTLE_DEPLOYMENTS=../contracts/deployments/sepolia.json
CASTLE_ABI_DIR=../contracts/out-abi
CASTLE_MINIAPP_CONFIG=../miniapp/config.json
# Where crew applications and relayed fill attempts are persisted.
CASTLE_DATA_DIR=./data
# handoff.lol public API, for agent_heartbeat liveness of fee/fi/fo/fum.
HANDOFF_API=https://handoff.lol/api/v1
# Seconds between chain polls.
CASTLE_POLL_SECONDS=4
