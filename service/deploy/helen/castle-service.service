[Unit]
Description=fee-fi-fo-fum castle service (MCP tools + castle SSE stream, port 8791)
After=network-online.target
[Service]
Type=simple
WorkingDirectory=%h/fee-fi-fo-fum/service
EnvironmentFile=%h/.config/castle/castle.env
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
ExecStart=%h/.nvm/versions/node/v22.23.2/bin/node src/server.mjs
Restart=always
RestartSec=3
[Install]
WantedBy=default.target
