[Unit]
Description=handoff tunnel agent for castle (https://handoff.lol/t/castle/ -> :8791)
After=network-online.target castle-service.service
[Service]
Type=simple
WorkingDirectory=%h
Environment=PATH=%h/.nvm/versions/node/v22.23.2/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.config/castle/tunnel.sh
Restart=always
RestartSec=3
[Install]
WantedBy=default.target
