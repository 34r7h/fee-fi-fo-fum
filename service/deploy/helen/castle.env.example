# ~/.config/castle/castle.env on the host (0600). No secrets in it: fi's key is a separate 0600 file outside the repo.
PORT=8791
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_RPC_URL_FALLBACK=https://sepolia.drpc.org,https://1rpc.io/sepolia
CASTLE_DATA_DIR=/home/<user>/.local/share/castle
CASTLE_SSE_WINDOW_MS=2500
CASTLE_PUBLIC_URL=https://handoff.lol/t/castle
HANDOFF_API=https://handoff.lol/api/v1
# fi's Sepolia key (one 0x-prefixed key, mode 0600): signs each harp Quote and each gateway response.
CASTLE_FI_KEY_PATH=/home/<user>/.config/castle/fi.key
# fo's route endpoint for castle_route (fo answers POST /route); unset, castle_route says fo is unreachable.
FO_URL=
